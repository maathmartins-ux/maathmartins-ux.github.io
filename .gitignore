# Repositorio PUBLICO em lista branca: tudo e ignorado, exceto o que esta listado.
# Arquivo novo exige editar esta lista E a LISTA_BRANCA do verificar_site.py.
/*
!/.gitignore
!/.gitattributes
!/.githooks/
!/docs/
!/tests/
!/README.md
!/pytest.ini
!/verificar_site.py
/docs/*
!/docs/*.html
!/docs/*.css
!/docs/.nojekyll
/tests/*
!/tests/test_*.py
